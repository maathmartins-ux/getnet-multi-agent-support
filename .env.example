# ---- LLM ----------------------------------------------------------------
# auto  -> uses Anthropic when ANTHROPIC_API_KEY is present, otherwise offline (deterministic, no network)
# anthropic | offline
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# ---- Web search (Knowledge Agent, general-purpose questions) ------------
# auto -> tavily when TAVILY_API_KEY is present, else duckduckgo (no key) ; disabled
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# ---- RAG ----------------------------------------------------------------
KNOWLEDGE_DIR=data/knowledge
RAG_TOP_K=4
ROUTER_CONFIDENCE_THRESHOLD=0.55

# ---- Support / escalation ----------------------------------------------
CRM_PATH=data/crm/customers.json
# Optional Teams/Slack-style incoming webhook notified on human handoff
HANDOFF_WEBHOOK_URL=

# ---- Ops ----------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
